# Copy to .env in the repo root and adjust values

# STORAGE_BACKEND=sqlite
# SQLITE_PATH=/data/tokens.db

# Redis connection
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

# Redis TLS
# REDIS_TLS=false
# REDIS_TLS_SKIP_VERIFY=false
# REDIS_CA_CERTS=

# REDIS_SOCKET_TIMEOUT=5.0
# REDIS_SOCKET_CONNECT_TIMEOUT=2.0
# REDIS_MAX_CONNECTIONS=20
# REDIS_HEALTH_CHECK_INTERVAL=30
# REDIS_RETRY_COUNT=3
# REDIS_CLIENT_NAME=wicket

# Auth secrets
PEPPER=change-me-pepper
ADMIN_USER=change-me
ADMIN_PASS=admin

# Token defaults
# TOKEN_TTL_SECONDS=0

# AUTH_FAILURE_WINDOW_SECONDS=60
# AUTH_MAX_FAILURES=10
